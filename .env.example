# Local service ports used by npm run dev:
# Main backend/API: http://localhost:4000
# Park Guide user API: http://localhost:4001
# Admin training API: http://localhost:4002
# Root hub: http://localhost:5173
# Admin frontend: http://localhost:5174/admin
# User frontend: http://localhost:5175/user
# Login frontend: http://localhost:5176/login
# Mobile preview (Expo web): http://localhost:8081
# Expo Go on phone: set EXPO_PUBLIC_API_URL to http://YOUR_PC_LAN_IP:4000
EXPO_PUBLIC_API_URL=
PORT=4000
# 0.0.0.0 lets Expo Go on your phone reach the guide API on this PC (same Wi-Fi).
API_HOST=0.0.0.0
API_PORT=4001
AUTH_API_HOST=0.0.0.0
JWT_SECRET=dev-secret-change-this
JWT_EXPIRES_IN=2h
ADMIN_API_PORT=4002
# Use * for easiest mobile web + Expo dev, or list origins (8081 is always merged on guide API).
CORS_ORIGIN=*

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=park_guide_database
DB_NAME=park_guide_database

# Leave empty in local dev so the Admin Vite app proxies /api to :4002 (no CORS issues).
VITE_ADMIN_API_BASE_URL=
VITE_MONITORING_API_BASE_URL=http://localhost:4000
VITE_USER_API_BASE_URL=http://localhost:4001
ADMIN_API_PUBLIC_URL=http://localhost:4002
DEMO_TRAINING_ASSET_BASE_URL=http://localhost:5175/user/training

INCIDENT_STORAGE=mysql
INCIDENT_MYSQL_FALLBACK=none
AI_EVIDENCE_DIR=alerts/ai
IOT_EVIDENCE_DIR=alerts/iot
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=ctip/sensor/plant-zone-01/proximity

DEVICE_TOKEN_AUTH_ENABLED=true
ROLE_CHECK_ENABLED=true
AI_CAMERA_TOKEN=change-me
IOT_SENSOR_TOKEN=change-me
ADMIN_DEMO_TOKEN=change-me
RANGER_DEMO_TOKEN=change-me

# ── Forgot Password / OTP Email ─────────────────────────────────────────────
# Gmail SMTP via App Password (Settings → Security → 2-Step → App Passwords).
# Other SMTP providers: set EMAIL_HOST, EMAIL_PORT, and EMAIL_SECURE accordingly.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="SFC Digital Park Guide <your-email@gmail.com>"

# Base URL of the login app — used to build the reset URL in email bodies.
# Must include the Vite base path (/login).
APP_BASE_URL=http://localhost:5176/login

# Redirect targets after login (used by the login SPA).
VITE_LOGIN_URL=http://localhost:5173/login/
VITE_USER_URL=http://localhost:5175/user
VITE_ADMIN_URL=http://localhost:5174/admin

PORT=4000
# 0.0.0.0 = accept connections from your phone on the same Wi-Fi (see Windows Firewall for PORT)
LISTEN_HOST=0.0.0.0
DB_HOST=localhost
DB_PORT=3306
# Local dev (swap for your MySQL user / DB as needed)
DB_USER=root
DB_PASSWORD=
DB_DATABASE=park_guide_database
# Incidents: memory is simplest for class projects; mysql for production-style persistence
INCIDENT_STORAGE=memory
INCIDENT_MYSQL_FALLBACK=memory
AI_EVIDENCE_DIR=/path/to/my-react-app/alerts/ai
IOT_EVIDENCE_DIR=/path/to/my-react-app/alerts/iot
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=ctip/sensor/plant-zone-01/proximity
# Optional device / role security (see server README)
DEVICE_TOKEN_AUTH_ENABLED=false
ROLE_CHECK_ENABLED=false
AI_CAMERA_TOKEN=change-me-ai-camera-token
IOT_SENSOR_TOKEN=change-me-iot-sensor-token
ADMIN_DEMO_TOKEN=change-me-admin-token
RANGER_DEMO_TOKEN=change-me-ranger-token
# Optional: require for POST /api/admin/publish-training-module (admin Vite: VITE_ADMIN_API_KEY)
# ADMIN_API_KEY=your-secret-key
